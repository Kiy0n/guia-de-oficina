{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guia de Oficina",
  "version": "1.6.0",
  "identifier": "br.com.guiadeoficina.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Guia de Oficina — Manual Técnico de Motocicletas",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/manuals": "manuals",
      "../data/manuals-index": "manuals-index"
    },
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"],
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
